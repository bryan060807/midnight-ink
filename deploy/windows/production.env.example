# Copy to the protected server-only .env.production.local file, never commit real values.
# These operator placeholders must be replaced after infrastructure verification.
HOST=<VERIFIED_WINDOWS_LAN_INTERFACE_ADDRESS>
PORT=3031
MIDNIGHT_INK_DATA_DIR=<ABSOLUTE_WINDOWS_DIRECTORY_OUTSIDE_CHECKOUT>
DATABASE_URL=postgresql://midnight_ink_app:<URL_ENCODED_OPERATOR_SECRET>@<VERIFIED_FEDORA_DATABASE_TLS_HOST>:<VERIFIED_POSTGRES_PORT>/midnight_ink?sslmode=verify-full
PGSSLROOTCERT=<ABSOLUTE_WINDOWS_PATH_TO_VERIFIED_DATABASE_CA_PEM>
PG_POOL_MAX=5
AIBRY_ID_ISSUER=https://id.aibrylabs.com
AIBRY_ID_CLIENT_ID=midnight-ink-public-web
APP_ORIGIN=https://midnight-ink.aibrylabs.com
SESSION_SECRET=<OPERATOR_GENERATED_STABLE_RANDOM_SECRET_AT_LEAST_32_BYTES>
LOCAL_DEMO_ENABLED=false
AIBRY_ID_ALLOW_HTTP_LOCALHOST=false
ROOK_PROVIDER=offline
# DEMO_IMPORT_TOKEN_HASH is normally absent. Enable only for a deliberate one-time claim.
