# COPY to ~/.config/midnight-ink/runtime.env; chmod 600. Do not commit real values.
NODE_ENV=production
LOCAL_DEMO_ENABLED=false
MIDNIGHT_INK_DATA_DIR=/app/.data
ROOK_PROVIDER=offline

AIBRY_ID_ISSUER=https://id.aibrylabs.com
AIBRY_ID_CLIENT_ID=midnight-ink-public-web
APP_ORIGIN=https://midnight-ink.aibrylabs.com
# Generate on host with a secure random generator; 32+ random bytes. DO NOT reuse sample.
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
