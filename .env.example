# Node.js 24 or newer. Copy to .env.local for Next.js development, then configure PostgreSQL.
# Local demo access is loopback-only and always disabled in NODE_ENV=production.
LOCAL_DEMO_ENABLED=true

# Required server-side PostgreSQL URL. Replace every placeholder; never commit real credentials.
# DATABASE_URL=postgresql://midnight_ink_app:<URL_ENCODED_SECRET>@<VERIFIED_DATABASE_TLS_HOST>:<VERIFIED_PORT>/midnight_ink?sslmode=verify-full
# PGSSLROOTCERT=<ABSOLUTE_PATH_TO_VERIFIED_DATABASE_CA_PEM>
# PG_POOL_MAX=5
# DATABASE_SCHEMA=public
# Explicit sslmode=disable is accepted only for loopback; reserve it for isolated local checks.
# Automated tests use TEST_DATABASE_URL pointing to an isolated disposable database, never production.

# Development defaults to HOST=127.0.0.1 and PORT=3031.
# HOST=127.0.0.1
# PORT=3031
# Normalized practice images only; all metadata is in PostgreSQL.
# MIDNIGHT_INK_DATA_DIR=.data
# Production requires an absolute data directory outside the checkout and explicit verified HOST.
# Use deploy/windows/production.env.example and docs/WINDOWS-FEDORA-DEPLOYMENT.md for Windows PM2.

# Offline coaching requires no account or key.
ROOK_PROVIDER=offline
# Optional server-side integration. Never use NEXT_PUBLIC_ for these settings.
# ROOK_PROVIDER=openai
# OPENAI_API_KEY=enter-locally-do-not-commit
OPENAI_MODEL=gpt-4.1-mini

# Optional AIBRY ID. Leave this block commented for the loopback development demo.
# These client/origin values are proposals, not verified registrations or hosting.
# Set all critical values together; keep SESSION_SECRET server-side and stable.
# AIBRY_ID_ISSUER=https://id.aibrylabs.com
# AIBRY_ID_CLIENT_ID=midnight-ink-public-web
# APP_ORIGIN=https://midnight-ink.aibrylabs.com
# SESSION_SECRET=<operator-generated-random-secret-at-least-32-bytes>
# Use LOCAL_DEMO_ENABLED=false when testing authenticated-only access.
# Isolated non-production mock issuers only; never enables HTTP in production.
# AIBRY_ID_ALLOW_HTTP_LOCALHOST=false

# Optional separate one-time demo claim verifier: SHA-256 hex of a random token.
# Never put the raw authorization token in this file or commit a real digest.
# DEMO_IMPORT_TOKEN_HASH=
