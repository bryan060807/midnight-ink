# Node.js 24 or newer. Copy to .env.local for Next.js development.
# Local demo access is loopback-only and always disabled in NODE_ENV=production.
LOCAL_DEMO_ENABLED=true

# Persistent SQLite and normalized practice images; relative to the project.
# MIDNIGHT_INK_DATA_DIR=.data
# Optional explicit SQLite file path (normally leave unset).
# DATABASE_PATH=/absolute/path/midnight-ink.sqlite

# Offline coaching requires no account or key.
ROOK_PROVIDER=offline
# Optional server-side integration. Never use NEXT_PUBLIC_ for these settings.
# ROOK_PROVIDER=openai
# OPENAI_API_KEY=enter-locally-do-not-commit
OPENAI_MODEL=gpt-4.1-mini
